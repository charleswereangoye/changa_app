// Owner: B - Person B (Database Design, Security Rules, Household, Activity Feed)
// Description: Cloud Firestore security rules
// TEMPORARY until Sat 24 Oct, B replaces it with real rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Temporary rule allowing authenticated users
      allow read, write: if request.auth != null;
    }
  }
}
